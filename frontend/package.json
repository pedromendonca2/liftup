{
  "name": "liftup-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first workout tracker built with Expo and React Native.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:web": "expo export --platform web --output-dir dist",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/native": "^7.3.14",
    "expo": "^57.0.8",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.17",
    "babel-jest": "^30.4.1",
    "babel-preset-expo": "57.0.4",
    "eslint": "^10.8.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^30.4.2",
    "jest-expo": "57.0.2",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ]
  },
  "overrides": {
    "postcss": "8.5.25",
    "react-server-dom-webpack": "19.0.8"
  },
  "license": "MIT"
}
