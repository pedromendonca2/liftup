# Environment variables para o frontend
# Copie este arquivo para .env e ajuste as configurações conforme necessário

# URL da API do backend
# Para desenvolvimento local, use seu IP da rede local
# Para produção, use a URL do seu servidor
EXPO_PUBLIC_API_URL=http://172.20.173.132:3000

# Configurações opcionais
EXPO_PUBLIC_APP_NAME=LiftUp
EXPO_PUBLIC_APP_VERSION=1.0.0