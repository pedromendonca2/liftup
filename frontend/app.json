{
  "expo": {
    "name": "LiftUp",
    "slug": "liftup-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/liftup-icon.png",
    "scheme": "liftup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liftup.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.liftup.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/liftup-icon.png",
        "backgroundColor": "#F8F8FF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/liftup-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/liftup-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8FF",
          "dark": {
            "backgroundColor": "#151718"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
