{
  "name": "liftup",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first workout tracker with adaptive load progression.",
  "scripts": {
    "setup": "npm ci --prefix frontend && npm ci --prefix backend",
    "mobile": "npm --prefix frontend start",
    "mobile:android": "npm --prefix frontend run android",
    "mobile:ios": "npm --prefix frontend run ios",
    "mobile:web": "npm --prefix frontend run web",
    "api": "npm --prefix backend run dev",
    "check": "npm run check:frontend && npm run check:backend",
    "check:frontend": "npm --prefix frontend run check",
    "check:backend": "npm --prefix backend run check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedromendonca2/liftup.git"
  }
}
